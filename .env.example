# Skopiuj do .env.local (poza gitem) i uzupełnij.

# --- Koordynator brain_control (komercyjny LLM, init_chat_model "dostawca:model") ---
HOST_MODEL=anthropic:claude-haiku-5-5
# Effort dla modeli Anthropic (low|medium|high); puste = domyślny modelu
HOST_EFFORT=low
ANTHROPIC_API_KEY=
# Inni dostawcy wymagają extras, np. `uv sync --all-packages --extra google`:
# HOST_MODEL=google_genai:gemini-...
# GOOGLE_API_KEY=

# --- Debatanci (Bielik przez vLLM) ---
DEBATER_BASE_URL=http://127.0.0.1:8000/v1
DEBATER_MODEL=bielik
DEBATER_API_KEY=EMPTY
DEBATER_TEMPERATURE=0.7
# Niezależne instancje SLM (przykładowe adresy i nazwy):
# DOGS_BASE_URL=http://127.0.0.1:8000/v1
# DOGS_MODEL=bielik-dogs
# CATS_BASE_URL=http://127.0.0.1:8003/v1
# CATS_MODEL=bielik-cats

# --- Serwer vLLM (infra/vllm.sh) ---
VLLM_MODEL=speakleash/Bielik-11B-v3.1-Instruct-AWQ
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
